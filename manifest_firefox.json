{
    "name": "XPP-Deck",
    "version": "0.1.0",
    "manifest_version": 2,
    "description": "The OpenSource Deck",
    "default_locale": "ja",
    "icons": {
        "128": "icon.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "opd_release@kwdev",
            "strict_min_version": "115.0"
        },
        "gecko_android": {
            "id": "opd_release@kwdev",
            "strict_min_version": "115.0"
        }
    },
    "web_accessible_resources": [
        "src/extensions/auto_reload_helper.js",
        "src/extensions/media_viewer_block_helper.js",
        "src/extensions/media_viewer/media_viewer.js",
        "public/icons/logo_icon.svg",
        "profile_debug.html",
        "public/icons/settings.svg",
        "public/icons/banner_hide.svg",
        "public/icons/top_hide.svg",
        "public/icons/pin.svg",
        "public/icons/pinned.svg",
        "public/icons/post.svg",
        "public/icons/column_move.svg",
        "public/icons/column_close.svg",
        "public/icons/column_w_size.svg",
        "public/icons/column_add_1st.svg",
        "public/icons/column_add_2nd.svg",
        "public/icons/tl_column.svg",
        "public/icons/notice_column.svg",
        "public/icons/exp_column.svg",
        "public/icons/lists_column.svg",
        "public/icons/custom_url_column.svg",
        "public/icons/single_view.svg",
        "public/icons/second_view.svg",
        "public/icons/profile_save.svg",
        "public/icons/profile_delete.svg",
        "public/icons/forward.svg",
        "public/icons/next.svg",
        "public/icons/download.svg",
        "public/icons/switch_theme.svg"
    ],
    "background": {
        "scripts": ["background.js"]
    },
    "permissions": [
        "storage",
        "webRequest",
        "declarativeNetRequest",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.twimg.com/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://twitter.com/*", "https://x.com/*"],
            "js": ["reload_guard.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://twitter.com/*", "https://x.com/*"],
            "js": [
                "src/content/prelude.js",
                "src/content/run.js",
                "src/content/settings.js",
                "src/extensions/auto_reload.js",
                "src/extensions/media_viewer_block.js",
                "src/extensions/media_viewer/media_viewer.js"
            ]
        }
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    }
}
