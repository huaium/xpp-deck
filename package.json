{
    "name": "xpp-deck",
    "private": true,
    "version": "0.1.0",
    "description": "Development utilities for XPP-Deck",
    "scripts": {
        "test": "node --test tests/*.test.mjs",
        "test:browser": "node tests/dialog.browser.mjs",
        "test:browser:loading": "node tests/loading.browser.mjs",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "wxt prepare && tsc -p tsconfig.json",
        "lint": "pnpm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "build": "pnpm run typecheck && wxt zip -b chrome && wxt zip -b firefox --mv2",
        "build:bundle": "pnpm run typecheck && wxt build -b chrome && wxt build -b firefox --mv2",
        "test:watch": "node tests/wxt-watch.integration.mjs",
        "test:browser:extension": "node tests/extension.browser.mjs",
        "dev": "wxt -b chrome",
        "dev:firefox": "wxt -b firefox --mv2",
        "prepare": "wxt prepare",
        "clean": "node utils/wxt-clean.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2",
        "vite": "^8.3.2",
        "web-ext": "latest",
        "wxt": "^0.21.4"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
    "dependencies": {
        "@awesome.me/webawesome": "^3.14.0",
        "@webcomponents/custom-elements": "^1.6.0",
        "element-internals-polyfill": "^3.0.2"
    }
}
