{
  "name": "open-deck",
  "private": true,
  "version": "1.1.3.2",
  "description": "Development utilities for Open-Deck",
  "scripts": {
    "webext:prepare": "rm -rf .web-ext-firefox-src && mkdir -p .web-ext-firefox-src && rsync -a --exclude='.git' --exclude='.github' --exclude='.serena' --exclude='.codex' --exclude='.DS_Store' --exclude='package' --exclude='package_tmp' --exclude='web-ext-artifacts' --exclude='.web-ext-firefox-src' --exclude='node_modules' --exclude='pnpm-lock.yaml' ./ .web-ext-firefox-src/ && cp .web-ext-firefox-src/manifest_firefox.json .web-ext-firefox-src/manifest.json",
    "webext:dev": "npm run webext:prepare && web-ext run --source-dir .web-ext-firefox-src",
    "webext:lint": "npm run webext:prepare && web-ext lint --source-dir .web-ext-firefox-src",
    "webext:build": "npm run webext:prepare && mkdir -p web-ext-artifacts && web-ext build --source-dir .web-ext-firefox-src --artifacts-dir web-ext-artifacts --overwrite-dest",
    "webext:clean": "rm -rf .web-ext-firefox-src"
  },
  "devDependencies": {
    "web-ext": "latest"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
